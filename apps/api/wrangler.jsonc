{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hono-better-auth",
	"main": "src/index.ts",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2026-03-24",
	"d1_databases": [
		{
			"binding": "hono_better_auth_db",
			"database_name": "hono-better-auth-db",
			"database_id": "d6e23cef-29d9-4d58-b69d-b49cce0c0d0e",
			"migrations_dir": "drizzle"
		}
	],
